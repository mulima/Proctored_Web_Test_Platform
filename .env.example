# Copy to .env for local development. On Railway set these as service variables instead.
#
# This deploys the PLATFORM, not any one course. Course identity (code, title,
# institution) and which database holds a course's data are set per-lecturer,
# through the app itself - see /signup and /{slug}/admin/setup, and
# docs/DATABASE_SCHEMA.md for what a lecturer's own database needs.

# --- required ---------------------------------------------------------------
SECRET_KEY=generate-with-python3-c-import-secrets-print-secrets-token-urlsafe-48
CREDENTIAL_ENCRYPTION_KEY=generate-with-python3-c-from-cryptography.fernet-import-Fernet;print(Fernet.generate_key().decode())
BASE_URL=https://your-app.up.railway.app

# --- platform database -------------------------------------------------------
# Holds lecturer accounts and their course settings, never course data itself.
# Railway injects DATABASE_URL when you attach a Postgres service. Leave it
# unset locally to use a SQLite file instead.
# DATABASE_URL=postgresql://...

# --- email ------------------------------------------------------------------
# console prints messages to the log; smtp and resend actually deliver. This is the
# PLATFORM DEFAULT - a lecturer can override it for their own course at
# /<slug>/admin/setup; anything they leave blank falls back to this.
MAIL_BACKEND=console
MAIL_FROM=Test Platform <no-reply@yourdomain.example>
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=you@gmail.com
# SMTP_PASSWORD=your-16-character-app-password
# RESEND_API_KEY=re_...

# --- registration (default a lecturer's course can override per-student) ----
REQUIRE_ADMIN_APPROVAL=false
# ALLOWED_EMAIL_DOMAINS=unza.zm

# --- proctoring thresholds --------------------------------------------------
ABSENCE_WARN_SECONDS=20
ABSENCE_FLAG_SECONDS=60
FULLSCREEN_GRACE_SECONDS=10
HIDDEN_WARN_SECONDS=15
STRIKE_FLAG_AFTER=3
SNAPSHOTS_ENABLED=true
SNAPSHOT_ALERT_MIN_INTERVAL_SECONDS=180
