# Copy to .env for local development. On Railway set these as service variables instead.
#
# Nothing in the code names a particular course. One deployment serves one course at a
# time, and which course that is comes entirely from the variables below.

# --- required ---------------------------------------------------------------
ADMIN_EMAIL=lecturer@example.edu
ADMIN_PASSWORD=change-this-before-you-deploy
SECRET_KEY=generate-with-python3-c-import-secrets-print-secrets-token-urlsafe-48
BASE_URL=https://your-app.up.railway.app

# --- database ---------------------------------------------------------------
# Railway injects DATABASE_URL when you attach a Postgres service. Leave it unset
# locally to use a SQLite file instead.
# DATABASE_URL=postgresql://...

# --- email ------------------------------------------------------------------
# console prints messages to the log; smtp and resend actually deliver.
MAIL_BACKEND=console
MAIL_FROM=Test Platform <no-reply@yourdomain.example>
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=you@gmail.com
# SMTP_PASSWORD=your-16-character-app-password
# RESEND_API_KEY=re_...

# --- who this deployment is for ---------------------------------------------
# All optional. Left blank, the platform shows its own name and describes itself
# generically; set them and the course appears on every page, email and PDF.
APP_NAME=Proctored Web Test Platform
COURSE_CODE=MBS6011
COURSE_TITLE=MBS6011: E-Business Strategies and Models
INSTITUTION=University of Zambia - Graduate School of Business

# --- registration -----------------------------------------------------------
# Leave false for open pre-registration gated by the emailed link. Set true to make
# the roster an allowlist you approve by hand in the admin panel.
REQUIRE_ADMIN_APPROVAL=false
# ALLOWED_EMAIL_DOMAINS=unza.zm

# --- proctoring thresholds --------------------------------------------------
ABSENCE_WARN_SECONDS=20
ABSENCE_FLAG_SECONDS=60
FULLSCREEN_GRACE_SECONDS=10
HIDDEN_WARN_SECONDS=15
STRIKE_FLAG_AFTER=3
SNAPSHOTS_ENABLED=true
SNAPSHOT_ALERT_MIN_INTERVAL_SECONDS=180
